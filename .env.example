# API adresleri (geliştirme sunucusunun proxy hedefleri).
# Değiştirmek için bu dosyayı .env olarak kopyalayın.
# API'leri launchSettings'teki "http" profiliyle çalıştırın; "https" profili
# isteği yönlendirdiğinde (307) proxy'nin arkasında sorun çıkar.
DEVICE_API_URL=http://localhost:5098
RULE_API_URL=http://localhost:5165
SATOPS_API_URL=http://localhost:5131
USER_API_URL=http://localhost:5050
LOGIN_API_URL=http://localhost:5002
