# API adresleri (geliştirme sunucusunun proxy hedefleri).
# Değiştirmek için bu dosyayı .env olarak kopyalayın.
# Varsayılanlar launchSettings'teki "http" profilidir; "dotnet run" bu profili kullanır.
DEVICE_API_URL=http://localhost:5098
RULE_API_URL=http://localhost:5165
SATOPS_API_URL=http://localhost:5131
USER_API_URL=http://localhost:5050
LOGIN_API_URL=http://localhost:5002

# API'leri "https" profiliyle çalıştırıyorsanız (ör. Visual Studio) aşağıdaki satırları açın.
# Sonra gelen satır öncekini geçersiz kılar. https profilinde http portu isteği https'e
# yönlendirir (307) ve tarayıcı bu yönlendirmeyi engeller.
# DEVICE_API_URL=https://localhost:7246
# RULE_API_URL=https://localhost:7286
# SATOPS_API_URL=https://localhost:7171
# USER_API_URL=https://localhost:7042
# LOGIN_API_URL=https://localhost:7095
